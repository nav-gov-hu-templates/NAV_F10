         </enumeration>
         <enumeration value="13">
            <annotation>
               <documentation>13=háztartási fémhulladékok</documentation>
            </annotation>
         </enumeration>
         <enumeration value="14">
            <annotation>
               <documentation>14=ipari és mezőgazdasági vízépítési berendezések és alkatrészek, zsilipek, árvízvédelmi berendezések és alkatrészei, földgáz építési vezeték, berendezés és alkatrész fémhulladéka</documentation>
